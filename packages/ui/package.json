{
  "name": "@nestrix-js/ui",
  "version": "0.1.0-alpha.0",
  "description": "Prebuilt Nestrix dashboard assets",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nestrix-js/nestrix.git",
    "directory": "packages/ui"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "build": "tsc -b && node scripts/build-assets.mjs",
    "check:package": "node scripts/check-size.mjs && publint && attw --pack . --profile esm-only",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@nestrix-js/protocol": "workspace:*",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.26",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.71.0",
    "nuqs": "2.10.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "uplot": "1.6.32",
    "vite": "8.3.7"
  }
}
