{
  "name": "@nestrix-js/nestjs",
  "version": "0.1.1",
  "description": "Nest-aware OpenTelemetry tracing for NestJS 12+, with an optional dashboard",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nestrix-js/nestrix.git",
    "directory": "packages/nestjs"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "build": "tsc -b",
    "check:package": "publint && attw --pack . --profile esm-only"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/microservices": "^12.0.4",
    "@nestrix-js/ui": "workspace:*",
    "@opentelemetry/api": ">=1.10.0 <1.11.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "pg": "^8.0.0",
    "reflect-metadata": "^0.1.12 || ^0.2.0",
    "rxjs": "^7.1.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/microservices": {
      "optional": true
    },
    "@nestrix-js/ui": {
      "optional": true
    },
    "@opentelemetry/exporter-logs-otlp-http": {
      "optional": true
    },
    "@opentelemetry/sdk-logs": {
      "optional": true
    },
    "@opentelemetry/exporter-metrics-otlp-http": {
      "optional": true
    },
    "@opentelemetry/sdk-metrics": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nats-io/transport-node": "^3.4.0",
    "@nestjs/bullmq": "^12.0.1",
    "@nestjs/common": "^12.4.2",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.2",
    "@nestjs/microservices": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "@nestjs/schedule": "^12.0.3",
    "@nestjs/testing": "^12.4.2",
    "@nestrix-js/protocol": "workspace:*",
    "@nestrix-js/testing": "workspace:*",
    "@nestrix-js/ui": "workspace:*",
    "@opentelemetry/api": "~1.10.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "amqp-connection-manager": "^5.0.1",
    "amqplib": "~2.2.0",
    "bullmq": "~6.7.2",
    "bullmq-otel": "^2.0.1",
    "express-esm": "workspace:*",
    "ioredis": "^6.0.0",
    "kafkajs": "^2.2.4",
    "mqtt": "^5.16.1",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "pg-query-stream": "^4.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "undici": "^7.30.2"
  },
  "dependencies": {
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@opentelemetry/core": "^3.1.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.1",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@opentelemetry/semantic-conventions": "^1.45.0"
  }
}
