{
  "name": "@nestrix/nestjs",
  "version": "0.0.0",
  "description": "Nest-aware OpenTelemetry tracing for NestJS 12+, with an optional dashboard",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nestrix-js/nestrix.git",
    "directory": "packages/nestjs"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "build": "tsc -b",
    "check:package": "publint && attw --pack . --profile esm-only"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/microservices": "^12.0.0",
    "@opentelemetry/api": ">=1.10.0 <1.11.0",
    "pg": "^8.0.0",
    "reflect-metadata": "^0.1.12 || ^0.2.0",
    "rxjs": "^7.1.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/microservices": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/microservices": "^12.4.2",
    "@opentelemetry/api": "~1.10.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
