{
  "name": "nestrix-workspace",
  "private": true,
  "description": "Open-source observability for NestJS 12+ (workspace root)",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nestrix-js/nestrix.git"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "vitest run --passWithNoTests",
    "lint": "biome check .",
    "typecheck": "tsc -b --noEmit",
    "docs:build": "pnpm --filter docs-site docs:build",
    "check:packages": "pnpm -r --if-present check:package",
    "check:tla": "node scripts/check-no-tla.mjs",
    "verify": "pnpm build && pnpm check:packages && pnpm check:tla && pnpm test && pnpm lint && pnpm typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.6",
    "@changesets/cli": "3.0.3",
    "publint": "^0.3.25",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
