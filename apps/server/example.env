# Copy to .env (ignored by version control). Placeholder only: choose your own, at least 12 characters.
NESTRIX_ADMIN_PASSWORD=change-me-please
# NESTRIX_RETENTION_DAYS=7
# Alerting: the dashboard address put in webhook notifications.
# NESTRIX_PUBLIC_URL=https://nestrix.example.com
# Alerting: webhook hosts allowed although they resolve to private or loopback addresses.
# NESTRIX_WEBHOOK_ALLOWED_HOSTS=alerts.internal,10.0.0.5
# Single sign-on (OpenID Connect), with viewer and admin roles; see README "Users, roles and single sign-on".
# The callback to register at the provider is <NESTRIX_PUBLIC_URL>/login/oidc/callback.
# NESTRIX_OIDC_ISSUER=https://login.example.com
# NESTRIX_OIDC_CLIENT_ID=nestrix
# NESTRIX_OIDC_CLIENT_SECRET_FILE=/run/secrets/nestrix_oidc_client_secret
# NESTRIX_OIDC_ADMIN_GROUPS=nestrix-admins
# NESTRIX_OIDC_ALLOWED_GROUPS=engineering
