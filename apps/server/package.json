{
  "name": "@nestrix-js/server",
  "version": "0.0.0",
  "private": true,
  "description": "Standalone Nestrix: OTLP/HTTP receiver, PostgreSQL storage, query API and dashboard. Distributed as a Docker image.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/main.js",
    "generate:proto": "node scripts/generate-proto.mjs",
    "record:fixtures": "node test/ingest/fixtures/record.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "@nestrix-js/nestjs": "workspace:*",
    "@nestrix-js/ui": "workspace:*",
    "@opentelemetry/api": "~1.10.0",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.75.0",
    "@bufbuild/protoc-gen-es": "^2.17.0",
    "@nestjs/testing": "^12.4.2",
    "@nestrix-js/protocol": "workspace:*",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.1",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1"
  }
}
